{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard_production_action.py"],
            "timeout": 15,
            "statusMessage": "Checking production and publishing gates"
          }
        ]
      }
    ]
  }
}
