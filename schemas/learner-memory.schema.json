{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://data-department.local/schemas/learner-memory.schema.json",
 "title": "Cross-skill Learner Memory",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "memory_id",
  "person_id",
  "version",
  "privacy_classification",
  "authority",
  "current_focus",
  "topics",
  "evidence_registry",
  "learning_events",
  "updated_at",
  "status"
 ],
 "properties": {
  "memory_id": {
   "type": "string",
   "minLength": 1
  },
  "person_id": {
   "type": "string",
   "minLength": 1
  },
  "version": {
   "type": "string",
   "minLength": 1
  },
  "privacy_classification": {
   "enum": [
    "private",
    "confidential",
    "restricted"
   ]
  },
  "authority": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "owner",
    "canonical_path",
    "storage_scope"
   ],
   "properties": {
    "owner": {
     "type": "string",
     "minLength": 1
    },
    "canonical_path": {
     "type": "string",
     "minLength": 1
    },
    "storage_scope": {
     "enum": [
      "project",
      "user",
      "second-brain"
     ]
    }
   }
  },
  "current_focus": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "topics": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "topic_id",
     "display_name",
     "skill_ids",
     "status",
     "mastery_level",
     "confidence",
     "compact_summary",
     "concepts",
     "decision_rules",
     "interfaces",
     "failure_modes",
     "prerequisites",
     "relevance_to",
     "evidence_refs",
     "last_learned_at",
     "last_demonstrated_at",
     "review_due_at",
     "source_version",
     "limitations"
    ],
    "properties": {
     "topic_id": {
      "type": "string",
      "minLength": 1
     },
     "display_name": {
      "type": "string",
      "minLength": 1
     },
     "skill_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "status": {
      "enum": [
       "unseen",
       "exposed",
       "practiced",
       "demonstrated",
       "mastered",
       "stale",
       "conflicted",
       "retired"
      ]
     },
     "mastery_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
     },
     "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "compact_summary": {
      "type": "string",
      "maxLength": 1200
     },
     "concepts": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "decision_rules": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "interfaces": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "failure_modes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
       "type": "string"
      }
     },
     "relevance_to": {
      "type": "array",
      "uniqueItems": true,
      "items": {
       "type": "string"
      }
     },
     "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
       "type": "string"
      }
     },
     "last_learned_at": {
      "type": "string"
     },
     "last_demonstrated_at": {
      "type": "string"
     },
     "review_due_at": {
      "type": "string"
     },
     "source_version": {
      "type": "string"
     },
     "safety_critical": {
      "type": "boolean"
     },
     "limitations": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "concept_keys": {
      "type": "array",
      "uniqueItems": true,
      "description": "Canonical concept keys (ck.<domain>.<slug>) this topic refers to; identity only, never evidence of mastery.",
      "items": {
       "type": "string",
       "pattern": "^ck\\.[a-z0-9-]+\\.[a-z0-9-]+$"
      }
     }
    }
   }
  },
  "evidence_registry": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "evidence_id",
     "type",
     "locator",
     "scope",
     "result",
     "validated_at",
     "validity_status",
     "transfer_scope"
    ],
    "properties": {
     "evidence_id": {
      "type": "string",
      "minLength": 1
     },
     "type": {
      "enum": [
       "learning",
       "practice",
       "project",
       "assessment",
       "production",
       "teaching",
       "review",
       "reflection"
      ]
     },
     "locator": {
      "type": "string",
      "minLength": 1
     },
     "scope": {
      "type": "string",
      "minLength": 1
     },
     "result": {
      "type": "string",
      "minLength": 1
     },
     "validated_at": {
      "type": "string"
     },
     "validity_status": {
      "enum": [
       "unverified",
       "verified",
       "expired",
       "rejected"
      ]
     },
     "transfer_scope": {
      "enum": [
       "not-applicable",
       "same-context",
       "changed-scenario"
      ]
     },
     "sha256": {
      "type": "string",
      "pattern": "^$|^[a-fA-F0-9]{64}$"
     }
    }
   }
  },
  "learning_events": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "event_id",
     "topic_id",
     "event_type",
     "skill_id",
     "evidence_refs",
     "occurred_at",
     "recorded_at"
    ],
    "properties": {
     "event_id": {
      "type": "string",
      "minLength": 1
     },
     "topic_id": {
      "type": "string",
      "minLength": 1
     },
     "event_type": {
      "enum": [
       "learned",
       "practiced",
       "applied",
       "assessed",
       "reviewed",
       "forgotten",
       "version-changed"
      ]
     },
     "skill_id": {
      "type": "string",
      "minLength": 1
     },
     "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
       "type": "string"
      }
     },
     "occurred_at": {
      "type": "string"
     },
     "recorded_at": {
      "type": "string"
     },
     "notes": {
      "type": "string"
     }
    }
   }
  },
  "updated_at": {
   "type": "string",
   "minLength": 1
  },
  "status": {
   "enum": [
    "draft",
    "active",
    "conflicted",
    "archived"
   ]
  }
 }
}
