{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-department.local/schemas/book-conversion-manifest.schema.json",
  "title": "Book to Knowledge Conversion Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["conversion_id", "owner", "version", "mode", "primary_destination", "source_manifest_ref", "source_ids", "rights_status", "content_type", "depth", "structure", "frameworks", "destination_artifacts", "traceability", "tests", "publication", "limitations", "status", "updated_at"],
  "properties": {
    "conversion_id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "mode": {"enum": ["analyze", "full", "fold-in", "update"]},
    "primary_destination": {"enum": ["skill", "second-brain", "career", "interview", "project", "curriculum", "workflow", "content"]},
    "source_manifest_ref": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "rights_status": {"enum": ["unverified", "private-use", "open-license", "owner-authorized", "publication-authorized", "blocked"]},
    "content_type": {"enum": ["text", "technical", "academic", "reference", "visual", "mixed"]},
    "depth": {"enum": ["reference", "study", "application"]},
    "structure": {"type": "object", "required": ["chapters_detected", "chapter_map_ref", "extraction_status"], "properties": {"chapters_detected": {"type": "integer", "minimum": 0}, "chapter_map_ref": {"type": "string"}, "extraction_status": {"enum": ["not-run", "partial", "passed", "failed"]}}},
    "frameworks": {"type": "array", "items": {"type": "object", "required": ["framework_id", "exact_name", "source_id", "locators"], "properties": {"framework_id": {"type": "string", "minLength": 1}, "exact_name": {"type": "string", "minLength": 1}, "source_id": {"type": "string", "minLength": 1}, "locators": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}},
    "destination_artifacts": {"type": "array", "items": {"type": "object", "required": ["artifact_id", "path", "sha256", "status"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "status": {"enum": ["draft", "generated", "tested", "approved", "published"]}}}},
    "traceability": {"type": "array", "items": {"type": "object", "required": ["material_id", "source_id", "locators"], "properties": {"material_id": {"type": "string", "minLength": 1}, "source_id": {"type": "string", "minLength": 1}, "locators": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}},
    "tests": {"type": "array", "items": {"type": "object", "required": ["test_id", "scope", "status", "evidence_ref"], "properties": {"test_id": {"type": "string", "minLength": 1}, "scope": {"enum": ["format", "links", "traceability", "copyright", "security", "retrieval", "application", "token-path"]}, "status": {"enum": ["not-run", "passed", "failed"]}, "evidence_ref": {"type": "string"}}}},
    "publication": {"type": "object", "required": ["status", "visibility", "authority_ref"], "properties": {"status": {"enum": ["not-published", "approved", "published", "blocked"]}, "visibility": {"enum": ["private", "public"]}, "authority_ref": {"type": "string"}}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["draft", "analyzed", "generated", "tested", "approved", "published", "blocked"]},
    "updated_at": {"type": "string", "minLength": 1}
  }
}
