{
  "name": "app-data-agent",
  "version": "0.3.0",
  "description": "Local launcher for the Data Department agent skills suite",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage deb",
    "test": "node --test --test-concurrency=1 'test/*.test.js'",
    "test:unit": "node --test test/graph.test.js test/suite.test.js",
    "shots:accept": "DA_ACCEPT_SHOTS=1 node --test test/visual.test.js"
  },
  "author": {
    "name": "kina2711",
    "email": "kienthai2711@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "vn.kina2711.dataagent",
    "productName": "Data Agent",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "synopsis": "Launcher for the Data Department agent skills suite",
      "desktop": {
        "Keywords": "claude;skills;data;agent;workflow;"
      }
    },
    "directories": {
      "buildResources": "build"
    }
  },
  "homepage": "https://github.com/kina2711/app-data-agent",
  "productName": "Data Agent"
}
