{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-department.local/schemas/evidence-envelope.schema.json",
  "title": "Data Department Evidence Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "task_id", "claim_ids", "artifact", "artifact_version", "artifact_sha256", "environment", "method", "observed_result", "status", "captured_at", "captured_by", "limitations"],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
    "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "artifact": {"type": "string", "minLength": 1},
    "artifact_version": {"type": "string", "minLength": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "environment": {"type": "object"},
    "method": {"type": "string", "minLength": 1},
    "command": {"type": "string"},
    "expected_result": {},
    "observed_result": {},
    "exit_status": {"type": ["integer", "null"]},
    "status": {"enum": ["passed", "failed", "observed", "not-run", "not-applicable"]},
    "captured_at": {"type": "string", "minLength": 1},
    "captured_by": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
