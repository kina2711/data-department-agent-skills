{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-department.local/schemas/workflow-manifest.schema.json",
  "title": "Executable Data Department Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow_id", "version", "objective", "status", "workflow_risk_tier", "current_task_id", "tasks", "transitions", "claims", "updated_at"],
  "properties": {
    "workflow_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "status": {"enum": ["planning", "ready", "executing", "testing", "awaiting-approval", "releasing", "monitoring", "blocked", "failed", "complete"]},
    "workflow_risk_tier": {"enum": ["R0-light", "R1-reviewed", "R2-standard", "R3-controlled", "R4-critical"]},
    "current_task_id": {"type": "string"},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "owner", "depends_on", "status", "risk_tier", "artifact_version", "artifact_sha256", "evidence_refs", "approval_refs"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
          "instance_id": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "status": {"enum": ["planned", "ready", "in-progress", "blocked", "failed", "implemented", "tested", "approved", "released", "complete"]},
          "risk_tier": {"enum": ["R0-light", "R1-reviewed", "R2-standard", "R3-controlled", "R4-critical"]},
          "artifact_version": {"type": "string"},
          "artifact_sha256": {"type": "string", "pattern": "^$|^[a-fA-F0-9]{64}$"},
          "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "approval_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "from_status", "to_status", "occurred_at", "evidence_refs"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
          "from_status": {"type": "string"},
          "to_status": {"type": "string"},
          "occurred_at": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "task_id", "wording", "evidence_refs", "status"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "task_id": {"type": "string", "minLength": 1},
          "wording": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "status": {"enum": ["draft", "verified", "rejected"]}
        }
      }
    },
    "updated_at": {"type": "string", "minLength": 1}
  }
}
