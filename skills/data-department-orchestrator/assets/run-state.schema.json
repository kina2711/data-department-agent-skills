{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-department.local/schemas/run-state.schema.json",
  "title": "Data Department Workflow State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "status",
    "lifecycle_profile",
    "risk_tier",
    "execution_path",
    "current_phase",
    "current_task",
    "completed_tasks",
    "passed_gates",
    "failed_tests",
    "blocked_by",
    "next_permitted_action",
    "updated_at"
  ],
  "properties": {
    "workflow_id": {"type": "string"},
    "status": {"enum": ["planning", "assessing", "designing", "executing", "testing", "awaiting-approval", "releasing", "monitoring", "blocked", "failed", "complete"]},
    "lifecycle_profile": {"type": "string"},
    "risk_tier": {"type": "string"},
    "execution_path": {"type": "string"},
    "current_phase": {"type": "string"},
    "current_task": {"type": "string"},
    "completed_tasks": {"type": "array", "items": {"type": "string"}},
    "passed_gates": {"type": "array", "items": {"type": "string"}},
    "failed_tests": {"type": "array", "items": {"type": "string"}},
    "blocked_by": {"type": "array", "items": {"type": "string"}},
    "next_permitted_action": {"type": "string"},
    "updated_at": {"type": "string"}
  }
}
