{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-department.local/schemas/approval-record.schema.json",
  "title": "Version-bound Approval Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["approval_id", "task_id", "scope", "artifact_version", "artifact_sha256", "risk_tier", "approver", "authority", "decision", "decided_at", "expires_at"],
  "properties": {
    "approval_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifact_version": {"type": "string", "minLength": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "risk_tier": {"enum": ["R1-reviewed", "R2-standard", "R3-controlled", "R4-critical"]},
    "approver": {"type": "string", "minLength": 1},
    "authority": {"type": "string", "minLength": 1},
    "decision": {"enum": ["approved", "rejected", "expired", "revoked"]},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "decided_at": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "minLength": 1}
  }
}
